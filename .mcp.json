{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ],
      "env": {}
    },
    "blender-community": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": { "BLENDER_PORT": "9877" }
    }
  }
}